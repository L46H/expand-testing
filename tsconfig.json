{
  "compilerOptions": {
    "target": "ES2022", 
    "module": "Node16", 
    "moduleResolution": "Node16", 
    "strict": true, 
    "noEmit": true, 
    "resolveJsonModule": true, 
    "esModuleInterop": true, 
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true 
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "constants/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}